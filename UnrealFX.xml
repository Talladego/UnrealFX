    <Windows>
        <!-- Runtime instance via CreateWindowFromTemplate(..., "Root"); do not put OnShutdown here. -->
        <Window name="UnrealFXTemplate" movable="false" savesettings="false" handleinput="false" layer="overlay">
            <Size>
                <AbsPoint x="456" y="256" />
            </Size>
            <Windows>
                <!-- Center-anchored like CustomUI SCT labels so scale/pulse grows from the middle. -->
                <DynamicImage name="$parentImage" texture="UnrealFX_annihilation" handleinput="false" layer="overlay">
                    <Size>
                        <AbsPoint x="456" y="256" />
                    </Size>
                    <Anchors>
                        <Anchor point="center" relativePoint="center" relativeTo="$parent">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>
            </Windows>
        </Window>
    </Windows>
</Interface>
